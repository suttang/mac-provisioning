# Config generated by Ghostty Config

theme = Atom One Dark
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
# font-family = "Hiragino Sans"
# font-family = "SF Mono"
# font-family = JetBrainsMonoNL Nerd Font Mono
# font-family = JetBrainsMonoNL Nerd Font Mono
font-family = "Menlo"
# font-family = "ヒラギノ角ゴ ProN"
font-family = "Hiragino Sans"
font-feature = -dlig
font-thicken = true
font-thicken-strength = 1
font-size = 14
alpha-blending = linear
cursor-style = block

# Command + Option + 右 → 次のタブ
keybind = super+alt+right=next_tab
# Command + Option + 左 → 前のタブ
keybind = super+alt+left=previous_tab

# どこにいるのかわかるようにする
unfocused-split-opacity = 0.45
